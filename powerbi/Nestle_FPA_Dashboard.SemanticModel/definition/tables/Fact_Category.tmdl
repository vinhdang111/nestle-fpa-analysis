table Fact_Category
	lineageTag: cea85b7c-bacb-5964-9116-72eece566ac2

	measure 'Category Sales' = SUM(Fact_Category[Sales])
		formatString: #,##0;(#,##0);-
		lineageTag: c7241f17-397f-5355-92ba-13456ab461ec

	measure 'Category UTOP Margin' = DIVIDE(SUM(Fact_Category[UTOP]), SUM(Fact_Category[Sales]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d5722890-5dd2-5d5b-91bf-aac11c1dfff7

	measure 'Category Sales (Selected Year)' = IF(HASONEVALUE(Dim_Year[Year]), [Category Sales], CALCULATE([Category Sales], Dim_Year[Year] = "FY2024"))
		formatString: #,##0;(#,##0);-
		displayFolder: Overview
		lineageTag: 27389657-061c-50fd-bdcf-c667405cd276

	column Year
		dataType: string
		lineageTag: 17c16326-3b70-5bf9-a18c-3b6525ce3512
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = User

	column Category
		dataType: string
		lineageTag: 022760db-5624-5e57-bcae-355f86c21deb
		summarizeBy: none
		sourceColumn: Category
		sortByColumn: CategorySort

		annotation SummarizationSetBy = User

	column CategorySort
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e0997250-9f1e-547c-9658-43e35111cce9
		summarizeBy: none
		sourceColumn: CategorySort

		annotation SummarizationSetBy = User

	column Sales
		dataType: double
		formatString: #,##0;(#,##0);-
		lineageTag: 1ef1f2cf-ea8c-58fa-8f27-8f1f1bdb61f1
		summarizeBy: none
		sourceColumn: Sales

		annotation SummarizationSetBy = User

	column UTOP
		dataType: double
		formatString: #,##0;(#,##0);-
		lineageTag: 34192c54-2059-5289-ba69-bb50a5050140
		summarizeBy: none
		sourceColumn: UTOP

		annotation SummarizationSetBy = User

	partition Fact_Category = m
		mode: import
		source =
				let
