table RF_COGS
	lineageTag: 64652b09-6f34-533a-a030-1d0774c42039

	measure 'COGS Scenario' =
			VAR d = LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "cogs")
			RETURN IF(HASONEVALUE(RF_COGS[COGS % of sales]), VALUES(RF_COGS[COGS % of sales]), d)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 47715d58-1fca-538c-8674-ea80a9740d4a

	column 'COGS % of sales'
		dataType: double
		formatString: 0.0%
		lineageTag: afe59cf4-ed8d-5331-9410-469106c13c5c
		summarizeBy: none
		sourceColumn: [COGS % of sales]

		extendedProperty ParameterMetadata =
				{
				  "version": 0
				}

		annotation SummarizationSetBy = User

	partition RF_COGS = calculated
		mode: import
		source = SELECTCOLUMNS(GENERATESERIES(521, 551, 1), "COGS % of sales", ROUND([Value] * 0.001, 4))

	annotation PBI_Id = aa149190dbb5534cadff0524f7b46843

