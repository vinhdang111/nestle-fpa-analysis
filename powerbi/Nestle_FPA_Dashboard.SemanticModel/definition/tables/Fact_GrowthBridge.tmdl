table Fact_GrowthBridge
	lineageTag: b8c59e6a-4b92-5de4-bb9a-fcbbfa871e7b

	measure 'Bridge Value' = CALCULATE(SUM(Fact_GrowthBridge[Value]), Fact_GrowthBridge[IsComponent] = 1)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c9a1e6cc-5f01-5442-a0c8-b825261ccaab

	measure 'Bridge Value FY25' = CALCULATE([Bridge Value], KEEPFILTERS(Fact_GrowthBridge[PeriodSort] >= 3))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6b1aba70-fa4f-56a9-a978-6ea9967da5ad

	measure 'KPI Organic Growth' = CALCULATE(SUM(Fact_GrowthBridge[Value]), Fact_GrowthBridge[Component] = "Organic growth", Fact_GrowthBridge[Period] = "FY2025 Actual")
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPI
		lineageTag: 47d334b6-61ae-57da-b6af-7732b350c9e7

	measure 'KPI Organic Growth vs Budget' = VAR a = [KPI Organic Growth] VAR b = CALCULATE(SUM(Fact_GrowthBridge[Value]), Fact_GrowthBridge[Component] = "Organic growth", Fact_GrowthBridge[Period] = "FY2025 Budget (Base)") RETURN "Budget " & FORMAT(b, "0.0%") & "  |  " & FORMAT((a - b) * 10000, "+0;-0") & " bps"
		displayFolder: KPI
		lineageTag: 2cae387f-3153-5f8d-8d93-a7e05f6d9aae

