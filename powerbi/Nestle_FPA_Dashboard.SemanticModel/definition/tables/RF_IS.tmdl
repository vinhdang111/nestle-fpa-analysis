table RF_IS
	lineageTag: 070a8e7b-eeda-53b2-a7c8-756dbda05dbb

	measure 'RF Scenario' =
			VAR f = IF(ISFILTERED(RF_GridFX[FX impact]), MAX(RF_GridFX[FX impact]), [FX Scenario])
			VAR c = IF(ISFILTERED(RF_GridCOGS[COGS % of sales]), MAX(RF_GridCOGS[COGS % of sales]), [COGS Scenario])
			VAR k = SELECTEDVALUE(RF_IS[Key], "np")
			VAR s = LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "s0") * (1 + LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "og") + LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "ma") + f)
			VAR orv = s * LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "orv")
			VAR cogs = -s * c
			VAR dist = -s * LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "dist")
			VAR mna = -s * LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "mna")
			VAR rd = -s * LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "rd")
			VAR utop = s + orv + cogs + dist + mna + rd
			VAR oti = s * LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "oti")
			VAR ooi = s * LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "ooi")
			VAR op = utop + oti + ooi
			VAR netfin = LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "netfin")
			VAR pbt = op + netfin
			VAR assoc = LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "assoc")
			VAR tax = -pbt * LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "tax")
			VAR pfy = pbt + assoc + tax
			VAR nci = -pfy * LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "nci")
			VAR np = pfy + nci
			VAR fcf = op + s * (LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "da") - LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "capex") - LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "intg")) + LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "cf_fixed") + tax * LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "taxpaid")
			RETURN SWITCH(k,
			    "sales", s, "orv", orv, "cogs", cogs, "dist", dist, "mna", mna, "rd", rd, "utop", utop,
			    "oti", oti, "ooi", ooi, "op", op, "netfin", netfin, "pbt", pbt, "assoc", assoc, "tax", tax,
			    "nci", nci, "np", np, "utopm", DIVIDE(utop, s), "npm", DIVIDE(np, s),
			    "eps", DIVIDE(np, LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "shares")), "fcf", fcf)
		displayFolder: FY2026 Reforecast
		lineageTag: 04333e59-bd61-5204-b7a6-24d877929bdb

		formatStringDefinition = SWITCH(SELECTEDVALUE(RF_IS[Format], "num"), "pct", "0.0%", "eps", "0.00", "#,##0;(#,##0);-")

	measure 'RF FY2025 Actual' = SUM(RF_IS[FY2025 Actual])
		displayFolder: FY2026 Reforecast
		lineageTag: 4441834a-c1d2-59b4-8e7a-84fe915f020e

		formatStringDefinition = SWITCH(SELECTEDVALUE(RF_IS[Format], "num"), "pct", "0.0%", "eps", "0.00", "#,##0;(#,##0);-")

	measure 'RF FY2026 Base' = SUM(RF_IS[FY2026 Base])
		displayFolder: FY2026 Reforecast
		lineageTag: 1d725c16-54e0-5eb5-a0e7-ccdba35a8d70

		formatStringDefinition = SWITCH(SELECTEDVALUE(RF_IS[Format], "num"), "pct", "0.0%", "eps", "0.00", "#,##0;(#,##0);-")

	measure 'RF Scenario vs Base' =
			VAR d = [RF Scenario] - [RF FY2026 Base]
			RETURN SWITCH(SELECTEDVALUE(RF_IS[Format]), "pct", ROUND(d * 10000, 0), "eps", ROUND(d, 2), ROUND(d, 0))
		displayFolder: FY2026 Reforecast
		lineageTag: d8d24d97-90fe-56ef-8ebc-b0a3a5bbc29f

		formatStringDefinition = SWITCH(SELECTEDVALUE(RF_IS[Format], "num"), "pct", "+0"" bps"";-0"" bps"";0"" bps""", "eps", "+0.00;-0.00;0.00", "+#,##0;-#,##0;0")

	measure 'RF KPI Sales' = CALCULATE([RF Scenario], RF_IS[Key] = "sales")
		formatString: #,##0;(#,##0);-
		displayFolder: FY2026 Reforecast\KPI
		lineageTag: 44fad605-5f00-5916-9628-22ef19cfe5fb

	measure 'RF KPI Sales Sub' =
			VAR b = CALCULATE([RF FY2026 Base], RF_IS[Key] = "sales")
			VAR a = CALCULATE([RF FY2025 Actual], RF_IS[Key] = "sales")
			RETURN "Base " & FORMAT(b, "#,##0") & " | FY25 " & FORMAT(a, "#,##0")
		displayFolder: FY2026 Reforecast\KPI
		lineageTag: 8d9c3bdf-21d0-5ec5-a1aa-3113d8ab42c0

	measure 'RF KPI UTOP Margin' = CALCULATE([RF Scenario], RF_IS[Key] = "utopm")
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: FY2026 Reforecast\KPI
		lineageTag: 9dcfcd97-34ab-5b54-933e-5c057ad00e1b

	measure 'RF KPI UTOP Margin Sub' =
			VAR b = CALCULATE([RF FY2026 Base], RF_IS[Key] = "utopm")
			VAR a = CALCULATE([RF FY2025 Actual], RF_IS[Key] = "utopm")
			RETURN "Base " & FORMAT(b, "0.0%") & " | FY25 " & FORMAT(a, "0.0%")
		displayFolder: FY2026 Reforecast\KPI
		lineageTag: 05765253-96a6-5847-819a-c9db2e58a9b2

	measure 'RF KPI Net Profit' = CALCULATE([RF Scenario], RF_IS[Key] = "np")
		formatString: #,##0;(#,##0);-
		displayFolder: FY2026 Reforecast\KPI
		lineageTag: 4a4d9074-06e9-529f-a769-f0674ce11b11

	measure 'RF KPI Net Profit Sub' =
			VAR b = CALCULATE([RF FY2026 Base], RF_IS[Key] = "np")
			VAR a = CALCULATE([RF FY2025 Actual], RF_IS[Key] = "np")
			RETURN "Base " & FORMAT(b, "#,##0") & " | FY25 " & FORMAT(a, "#,##0")
		displayFolder: FY2026 Reforecast\KPI
		lineageTag: 3e14bce3-c9bc-5ebf-b0d8-589aeb089d69

	measure 'RF KPI EPS' = CALCULATE([RF Scenario], RF_IS[Key] = "eps")
		formatString: 0.00
		displayFolder: FY2026 Reforecast\KPI
		lineageTag: 5761010f-b23f-5a26-8b71-6d3bca27687b

	measure 'RF KPI EPS Sub' =
			VAR b = CALCULATE([RF FY2026 Base], RF_IS[Key] = "eps")
			VAR a = CALCULATE([RF FY2025 Actual], RF_IS[Key] = "eps")
			RETURN "Base " & FORMAT(b, "0.00") & " | FY25 " & FORMAT(a, "0.00")
		displayFolder: FY2026 Reforecast\KPI
		lineageTag: ec08f2f8-20aa-51f6-8ad6-82effa1c8b29

	measure 'RF KPI FCF' = CALCULATE([RF Scenario], RF_IS[Key] = "fcf")
		formatString: #,##0;(#,##0);-
		displayFolder: FY2026 Reforecast\KPI
		lineageTag: 4f4533fa-41c4-5998-ae9c-6c44cac22566

	measure 'RF KPI FCF Sub' =
			VAR b = CALCULATE([RF FY2026 Base], RF_IS[Key] = "fcf")
			VAR a = CALCULATE([RF FY2025 Actual], RF_IS[Key] = "fcf")
			RETURN "Base " & FORMAT(b, "#,##0") & " | FY25 " & FORMAT(a, "#,##0")
		displayFolder: FY2026 Reforecast\KPI
		lineageTag: b62cec3d-c0ad-5c34-adec-6866094d9668

	measure 'RF Chart Sales Actual' =
			VAR y = SELECTEDVALUE(RF_Years[Year])
			RETURN IF(y <> "FY2026F", CALCULATE([Sales Actual], TREATAS({y}, Dim_Year[Year])))
		formatString: #,##0;(#,##0);-
		displayFolder: FY2026 Reforecast\Charts
		lineageTag: 78641429-1e83-57f8-95b6-3eb870914d58

	measure 'RF Chart Sales Reforecast' =
			VAR y = SELECTEDVALUE(RF_Years[Year])
			RETURN IF(y = "FY2026F", CALCULATE([RF Scenario], RF_IS[Key] = "sales"))
		formatString: #,##0;(#,##0);-
		displayFolder: FY2026 Reforecast\Charts
		lineageTag: 93cb1312-b50f-5486-8b41-c595af35c95e

	measure 'RF Chart NP Actual' =
			VAR y = SELECTEDVALUE(RF_Years[Year])
			RETURN IF(y <> "FY2026F", CALCULATE([Net Profit Actual], TREATAS({y}, Dim_Year[Year])))
		formatString: #,##0;(#,##0);-
		displayFolder: FY2026 Reforecast\Charts
		lineageTag: 4580a099-5f1a-524c-aaf7-e7cf3c91449d

	measure 'RF Chart NP Reforecast' =
			VAR y = SELECTEDVALUE(RF_Years[Year])
			RETURN IF(y = "FY2026F", CALCULATE([RF Scenario], RF_IS[Key] = "np"))
		formatString: #,##0;(#,##0);-
		displayFolder: FY2026 Reforecast\Charts
		lineageTag: 50cf6282-4675-57fe-b13b-7c3d66cc38b0

	measure 'RF Chart NP Margin' =
			VAR y = SELECTEDVALUE(RF_Years[Year])
			RETURN IF(y = "FY2026F", CALCULATE([RF Scenario], RF_IS[Key] = "npm"), CALCULATE([Net Profit Margin Actual], TREATAS({y}, Dim_Year[Year])))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: FY2026 Reforecast\Charts
		lineageTag: afdd00c9-110b-57ce-8634-e7fa346e279a

	measure 'RF Grid Net Profit' = CALCULATE([RF Scenario], RF_IS[Key] = "np")
		formatString: #,##0;(#,##0);-
		displayFolder: FY2026 Reforecast
		lineageTag: 9a4947f1-1cd2-5ca9-8463-d93c73a893e4

	measure 'RF Grid Color' =
			VAR v = [RF Grid Net Profit]
			VAR isBase = ROUND(MAX(RF_GridFX[FX impact]) - LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "fx"), 4) = 0 && ROUND(MAX(RF_GridCOGS[COGS % of sales]) - LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "cogs"), 4) = 0
			RETURN IF(isBase, "#63513D", IF(v >= LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "np_fy25"), "#DCE6CF", "#F2D5CC"))
		displayFolder: FY2026 Reforecast\Formatting
		lineageTag: 8e0fe031-946b-56bd-90dd-222c2f174b86

	measure 'RF Grid Font Color' = IF(ROUND(MAX(RF_GridFX[FX impact]) - LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "fx"), 4) = 0 && ROUND(MAX(RF_GridCOGS[COGS % of sales]) - LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "cogs"), 4) = 0, "#FFFFFF", "#3A3027")
		displayFolder: FY2026 Reforecast\Formatting
		lineageTag: 70fb1472-a224-5851-9092-cb369f17551d

	measure 'RF Basis Color' = SWITCH(SELECTEDVALUE(RF_Assumptions[Basis]), "Guided", "#DCE6CF", "Judgement", "#F7EBCB", "#FFFFFF")
		displayFolder: FY2026 Reforecast\Formatting
		lineageTag: 21d52dd1-3cbf-5f8c-b5bb-0421724fe5a8

	measure 'RF Scenario Label' = "Current scenario:  FX " & FORMAT([FX Scenario], "0.00%") & "   ·   COGS " & FORMAT([COGS Scenario], "0.0%") & " of sales"
		displayFolder: FY2026 Reforecast
		lineageTag: f716d39e-f8c9-5a8c-add0-f45a85ecd71f

	measure 'RF Base Label' = "Base:  FX " & FORMAT(LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "fx"), "0.0%") & " (Nestlé guidance, 23-Jul-2026)   ·   COGS " & FORMAT(LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "cogs"), "0.0%") & " (H1-2026 level)"
		displayFolder: FY2026 Reforecast
		lineageTag: c67aeb6b-6548-51a2-8018-f0f5294ac51b

	measure 'RF Result Label' =
			VAR np = CALCULATE([RF Scenario], RF_IS[Key] = "np")
			VAR npb = CALCULATE([RF FY2026 Base], RF_IS[Key] = "np")
			VAR m = CALCULATE([RF Scenario], RF_IS[Key] = "npm")
			RETURN "Net profit " & FORMAT(np, "#,##0") & " (Base " & FORMAT(npb, "#,##0") & ", " & FORMAT(np - npb, "+#,##0;-#,##0;0") & ")   ·   Net profit margin " & FORMAT(m, "0.0%")
		displayFolder: FY2026 Reforecast
		lineageTag: d3ba59f4-b1ef-513e-ad5b-5fc1055490c3

	measure 'RF Scenario Note' = "Scenario: FX " & FORMAT([FX Scenario], "0.0%") & "  ·  COGS " & FORMAT([COGS Scenario], "0.0%") & "      Base: FX " & FORMAT(LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "fx"), "0.0%") & " (Nestlé guidance, 23-Jul-2026), COGS " & FORMAT(LOOKUPVALUE(RF_Drivers[Value], RF_Drivers[Key], "cogs"), "0.0%") & " (H1-2026 level)"
		displayFolder: FY2026 Reforecast
		lineageTag: c9234d71-9d81-5da9-a12f-3dbda013e2cf

	column Key
		dataType: string
		isHidden
		lineageTag: 1ebdc939-4792-577b-a013-48ec1b1e1908
