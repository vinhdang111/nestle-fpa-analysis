		annotation SummarizationSetBy = User

	column 'FY2025 Actual'
		dataType: double
		isHidden
		lineageTag: 2e8edcd3-f6a8-5da5-91f3-171d9122c2a7
		summarizeBy: none
		sourceColumn: FY2025 Actual

		annotation SummarizationSetBy = User

	column 'FY2026 Base'
		dataType: double
		isHidden
		lineageTag: c909e8d5-8ada-589b-8011-afecf141d530
		summarizeBy: none
		sourceColumn: FY2026 Base

		annotation SummarizationSetBy = User

	partition RF_IS = m
		mode: import
		source =
				let
					Source = #table(
						type table [Key = text, Line = text, Sort = Int64.Type, Format = text, IsSubtotal = Int64.Type, #"FY2025 Actual" = number, #"FY2026 Base" = number],
						{
							{"sales", "Sales", 1, "num", 0, 89490, 90026.94},
							{"orv", "Other revenue", 2, "num", 0, 395, 405.12123},
							{"cogs", "Cost of goods sold", 3, "num", 0, -48694, -48254.43984},
							{"dist", "Distribution expenses", 4, "num", 0, -7306, -7562.26296},
							{"mna", "Marketing & administration", 5, "num", 0, -17883, -18095.41494},
							{"rd", "Research & development", 6, "num", 0, -1613, -1620.48492},
							{"utop", "Underlying trading operating profit (UTOP)", 7, "num", 1, 14389, 14899.45857},
							{"oti", "Other trading items, net", 8, "num", 0, -1714, -1980.59268},
							{"ooi", "Other operating items, net", 9, "num", 0, -398, -1350.4041},
							{"op", "Operating profit", 10, "num", 1, 12277, 11568.46179},
							{"netfin", "Net financial expense", 11, "num", 0, -1526, -1403.92},
							{"pbt", "Profit before taxes & associates", 12, "num", 1, 10751, 10164.54179},
							{"assoc", "Income from associates & JVs", 13, "num", 0, 1143, 857.25},
							{"tax", "Taxes", 14, "num", 0, -2640, -2693.60357435},
							{"nci", "Non-controlling interests", 15, "num", 0, -221, -249.8456464695},
							{"np", "Net profit", 16, "num", 1, 9033, 8078.3425691805},
							{"utopm", "UTOP margin", 17, "pct", 0, 0.160788914962566, 0.1655},
							{"npm", "Net profit margin", 18, "pct", 0, 0.100938652363393, 0.089732501950866},
							{"eps", "Basic EPS (CHF)", 19, "eps", 0, 3.51, 3.14087969252741},
							{"fcf", "Free cash flow (derived)", 20, "num", 1, 10993, 10683.69179052}
						}
					)
				in
					Source

	annotation PBI_ResultType = Table

