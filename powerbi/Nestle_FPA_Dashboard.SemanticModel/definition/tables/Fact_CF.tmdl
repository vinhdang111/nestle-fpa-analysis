table Fact_CF
	lineageTag: c26a6580-07a0-5eae-a3db-684edd1752ca

	measure 'CF Value' = SUM(Fact_CF[Value])
		formatString: #,##0;(#,##0);-
		displayFolder: Base
		lineageTag: 0e536da8-13c0-5a74-928b-8445d59f1a63

	measure 'CF Actual' = CALCULATE([CF Value], Dim_Scenario[Scenario] = "Actual")
		formatString: #,##0;(#,##0);-
		displayFolder: Base
		lineageTag: fe1f5b0a-6d74-59e1-912c-ca91254b6334

	measure 'CF Budget Base' = CALCULATE([CF Value], Dim_Scenario[Scenario] = "Budget - Base")
		formatString: #,##0;(#,##0);-
		displayFolder: Base
		lineageTag: 31b58fec-9b35-5077-8fbb-60e9e865d26b

	measure 'FY25 CF Budget (Base)' = CALCULATE([CF Budget Base], Dim_Year[Year] = "FY2025")
		formatString: #,##0;(#,##0);-
		displayFolder: Budget vs Actual
		lineageTag: 0f6a56d5-0a3b-56de-8b5b-0378065fb9da

	measure 'FY25 CF Actual' = CALCULATE([CF Actual], Dim_Year[Year] = "FY2025")
		formatString: #,##0;(#,##0);-
		displayFolder: Budget vs Actual
		lineageTag: 3e1c0542-31c3-511d-8e35-89f626e25ce8

	measure 'FY25 CF Variance' = IF(NOT ISBLANK([FY25 CF Actual]) && NOT ISBLANK([FY25 CF Budget (Base)]), [FY25 CF Actual] - [FY25 CF Budget (Base)])
		formatString: #,##0;(#,##0);-
		displayFolder: Budget vs Actual
		lineageTag: d45e1952-ea55-5174-a2b1-024b6d9774d2

	measure 'KPI FCF' = CALCULATE([CF Actual], Dim_LineItem[LineItem] = "Free cash flow (as reported)", Dim_Year[Year] = "FY2025")
		formatString: #,##0;(#,##0);-
		displayFolder: KPI
		lineageTag: 299a5882-cb71-51fd-b99f-4738a0fa1d42

	measure 'KPI FCF vs Budget' = VAR a = [KPI FCF] VAR b = CALCULATE([CF Budget Base], Dim_LineItem[LineItem] = "Free cash flow (derived)", Dim_Year[Year] = "FY2025") RETURN "Budget " & FORMAT(b, "#,##0") & "  |  " & FORMAT(DIVIDE(a - b, ABS(b)), "+0.0%;-0.0%")
		displayFolder: KPI
		lineageTag: 95cb41d5-229f-5e88-a128-79dc269afe36

	measure 'Scenario FCF FY25' = CALCULATE([CF Value], Dim_LineItem[LineItem] = "Free cash flow (derived)", Dim_Year[Year] = "FY2025")
		formatString: #,##0;(#,##0);-
		displayFolder: Scenarios
		lineageTag: 24ee9e13-0397-5fa2-a544-0d70d6ce6992

	column Year
		dataType: string
		lineageTag: 9116e9b6-bf55-5247-8013-0e6eea23b8be
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = User

	column Scenario
		dataType: string
		lineageTag: 2eeeb46d-a0d8-5c0b-828b-f40f933a26e6
		summarizeBy: none
		sourceColumn: Scenario

		annotation SummarizationSetBy = User

	column LineItem
