table Fact_Drivers
	lineageTag: 5a4d2188-be58-5136-8204-e25a907d7fe1

	measure 'Range Score' = SUM(Fact_Drivers[RangeScore])
		formatString: 0%;-0%;0%
		lineageTag: bc026ecd-2c69-51e2-b2fd-a33c58886979

	measure 'Range Score Color' = VAR s = [Range Score] RETURN IF(s > 1, "#B5543C", IF(s < -1, "#6F8B4E", "#B08D57"))
		displayFolder: Formatting
		lineageTag: 0f294d74-1d88-583e-acd0-bfb142bf2299

	measure 'Result Color' = SWITCH(SELECTEDVALUE(Fact_Drivers[Result]), "Worse than Adverse", "#EFCFC4", "Better than Favorable", "#D8E3C6", "#FFFCF4")
		displayFolder: Formatting
		lineageTag: 6552cda6-867c-5f31-b4f4-3438227922a8

	measure 'Drivers Outside Range' = FORMAT(CALCULATE(COUNTROWS(Fact_Drivers), Fact_Drivers[Result] <> "Within scenario range"), "0") & " of " & FORMAT(COUNTROWS(Fact_Drivers), "0")
		displayFolder: KPI
		lineageTag: 7bdedf85-c300-573a-bfb7-50317314fe1d

	measure 'Drivers Worse than Adverse' = CALCULATE(COUNTROWS(Fact_Drivers), Fact_Drivers[Result] = "Worse than Adverse") + 0
		formatString: 0
		displayFolder: KPI
		lineageTag: 110dc2ef-39e0-5bf6-ad35-f9b3546e55d5

	measure 'Drivers Better than Favorable' = CALCULATE(COUNTROWS(Fact_Drivers), Fact_Drivers[Result] = "Better than Favorable") + 0
		formatString: 0
		displayFolder: KPI
		lineageTag: 1523f130-766b-5471-be75-c1c591ef5e30

	measure 'Drivers Within Range' = CALCULATE(COUNTROWS(Fact_Drivers), Fact_Drivers[Result] = "Within scenario range") + 0
		formatString: 0
		displayFolder: KPI
		lineageTag: 63500e18-756c-5626-9caa-6b87d8caa4ec

