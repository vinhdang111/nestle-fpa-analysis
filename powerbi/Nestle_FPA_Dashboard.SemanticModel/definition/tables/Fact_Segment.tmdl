table Fact_Segment
	lineageTag: a7cb705f-7c5e-5fd8-a377-09273b5b6ae5

	measure 'Segment Sales' = SUM(Fact_Segment[Sales])
		formatString: #,##0;(#,##0);-
		lineageTag: c6fb7560-794d-5078-8773-781cdc7d2118

	measure 'Segment UTOP Margin' = DIVIDE(SUM(Fact_Segment[UTOP]), SUM(Fact_Segment[Sales]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 56cac0d7-32b6-5b57-ac33-ec8f03053133

	measure 'Zone Sales' = CALCULATE(SUM(Fact_Segment[Sales]), KEEPFILTERS(Fact_Segment[SegmentType] = "Geographic zone"))
		formatString: #,##0;(#,##0);-
		displayFolder: Overview
		lineageTag: e7bcddf3-086a-5990-b79d-67406713f23b

	measure 'Zone UTOP' = CALCULATE(SUM(Fact_Segment[UTOP]), KEEPFILTERS(Fact_Segment[SegmentType] = "Geographic zone"))
		formatString: #,##0;(#,##0);-
		displayFolder: Overview
		lineageTag: 55f3e265-c51a-5833-89be-47e2603c8f89

	measure 'Global Business Sales' = CALCULATE(SUM(Fact_Segment[Sales]), KEEPFILTERS(Fact_Segment[SegmentType] = "Global business"))
		formatString: #,##0;(#,##0);-
		displayFolder: Overview
		lineageTag: a45ee24a-93d2-58db-8633-9f729df02bb1

	measure 'Global Business UTOP' = CALCULATE(SUM(Fact_Segment[UTOP]), KEEPFILTERS(Fact_Segment[SegmentType] = "Global business"))
		formatString: #,##0;(#,##0);-
		displayFolder: Overview
		lineageTag: 32755f6b-95cd-5ad9-848e-4b5cf3845f74

	measure 'Zone Sales (Selected Year)' = IF(HASONEVALUE(Dim_Year[Year]), [Zone Sales], CALCULATE([Zone Sales], Dim_Year[Year] = "FY2024"))
		formatString: #,##0;(#,##0);-
		displayFolder: Overview
		lineageTag: ed8759e9-c34f-56e0-89a4-195279f46d76

	measure 'Zone UTOP Margin (Selected Year)' = DIVIDE(IF(HASONEVALUE(Dim_Year[Year]), [Zone UTOP], CALCULATE([Zone UTOP], Dim_Year[Year] = "FY2024")), [Zone Sales (Selected Year)])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Overview
		lineageTag: 5956c47f-6e3c-5908-b70e-278bf520791e

	measure 'Global Business Sales (Selected Year)' = IF(HASONEVALUE(Dim_Year[Year]), [Global Business Sales], CALCULATE([Global Business Sales], Dim_Year[Year] = "FY2024"))
		formatString: #,##0;(#,##0);-
		displayFolder: Overview
		lineageTag: ac9c5558-d549-5faa-905b-cf9ff7decd09

	measure 'Global Business UTOP Margin (Selected Year)' = DIVIDE(IF(HASONEVALUE(Dim_Year[Year]), [Global Business UTOP], CALCULATE([Global Business UTOP], Dim_Year[Year] = "FY2024")), [Global Business Sales (Selected Year)])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Overview
		lineageTag: 3e5c1dad-ae4e-5ac0-aef4-bf937bfb814b

	measure 'Selected Year' = SELECTEDVALUE(Dim_Year[Year], "FY2024")
		displayFolder: Overview
		lineageTag: 2d49f007-38dd-5c58-972f-a89196d18eb3

