	measure 'BV Bar Color' = SWITCH(SELECTEDVALUE(Fact_BudgetView[Label]), "FY2024 Actual", "#5E7486", "FY2025 Adverse", "#B5543C", "FY2025 Base", "#63513D", "FY2025 Favorable", "#6F8B4E", "#B08D57")
		displayFolder: Formatting
		lineageTag: 7e8eb6bf-62a4-5262-808a-1dd1928a95a8

	measure 'Budget Base Sales' = CALCULATE([BV Sales], Fact_BudgetView[Label] = "FY2025 Base")
		formatString: #,##0;(#,##0);-
		displayFolder: KPI
		lineageTag: ef596ebe-2c38-5a16-995f-062cafe3dbcf

	measure 'Budget Sales Range' = "Adverse " & FORMAT(CALCULATE([BV Sales], Fact_BudgetView[Label] = "FY2025 Adverse"), "#,##0") & "  |  Favorable " & FORMAT(CALCULATE([BV Sales], Fact_BudgetView[Label] = "FY2025 Favorable"), "#,##0")
		displayFolder: KPI
		lineageTag: 05574662-0db4-5c04-ad78-3126c4784b1f

