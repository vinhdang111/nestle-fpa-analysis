table Fact_BudgetView
	lineageTag: e969fea2-7b0c-5625-822c-eff2b5c2ccf8

	measure 'BV Sales' = CALCULATE(SUM(Fact_BudgetView[Value]), Fact_BudgetView[Metric] = "Sales")
		formatString: #,##0;(#,##0);-
		lineageTag: acae8907-c312-5762-be43-24a02cbf142f

	measure 'BV UTOP Margin' = CALCULATE(SUM(Fact_BudgetView[Value]), Fact_BudgetView[Metric] = "UTOP margin")
