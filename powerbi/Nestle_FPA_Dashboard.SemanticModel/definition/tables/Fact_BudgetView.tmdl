	measure 'Budget UTOP Margin Range' = "Adverse " & FORMAT(CALCULATE([BV UTOP Margin], Fact_BudgetView[Label] = "FY2025 Adverse"), "0.0%") & "  |  Favorable " & FORMAT(CALCULATE([BV UTOP Margin], Fact_BudgetView[Label] = "FY2025 Favorable"), "0.0%")
