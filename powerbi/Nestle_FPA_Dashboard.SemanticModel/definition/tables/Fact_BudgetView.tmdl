	measure 'Budget Net Profit Range' = "Adverse " & FORMAT(CALCULATE([BV Net Profit], Fact_BudgetView[Label] = "FY2025 Adverse"), "#,##0") & "  |  Favorable " & FORMAT(CALCULATE([BV Net Profit], Fact_BudgetView[Label] = "FY2025 Favorable"), "#,##0")
