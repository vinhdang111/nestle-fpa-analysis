table Fact_EPS
	lineageTag: 7ed375cc-b941-5473-a6af-0816808158dd

	measure 'EPS Value' = SUM(Fact_EPS[EPS])
		formatString: 0.00
		lineageTag: f1e21ea8-4005-53bf-bc6e-f2b630ae136d

	column Year
		dataType: string
		lineageTag: 9543b06b-2832-5616-b55a-c787cb7e766f
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = User

	column Scenario
		dataType: string
		lineageTag: fb1232a3-ca6a-5b64-808f-81d6ae12cf5f
		summarizeBy: none
		sourceColumn: Scenario

		annotation SummarizationSetBy = User

	column EPS
		dataType: double
		formatString: 0.00
		lineageTag: 553a956e-1e8a-57f9-a7eb-a51d91db8912
		summarizeBy: none
		sourceColumn: EPS

		annotation SummarizationSetBy = User

	partition Fact_EPS = m
		mode: import
		source =
				let
					Source = #table(
						type table [Year = text, Scenario = text, EPS = number],
						{
							{"FY2021", "Actual", 6.06},
							{"FY2022", "Actual", 3.42},
							{"FY2023", "Actual", 4.24},
							{"FY2024", "Actual", 4.19},
							{"FY2025", "Actual", 3.51},
							{"FY2025", "Budget - Adverse", 3.26844},
							{"FY2025", "Budget - Base", 4.152158},
							{"FY2025", "Budget - Favorable", 5.037863}
						}
					)
				in
					Source

	annotation PBI_ResultType = Table

