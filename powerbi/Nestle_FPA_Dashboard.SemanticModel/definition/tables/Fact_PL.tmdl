table Fact_PL
	lineageTag: c495a7ef-d624-50b7-b4ea-e54a07a488d3

	measure 'PL Value' = SUM(Fact_PL[Value])
		formatString: #,##0;(#,##0);-
		displayFolder: Base
		lineageTag: 98f63074-bb60-5d6e-8d2e-fa2d2189e419

	measure 'PL Actual' = CALCULATE([PL Value], Dim_Scenario[Scenario] = "Actual")
		formatString: #,##0;(#,##0);-
		displayFolder: Base
		lineageTag: 91808f49-434d-5f7d-9fa0-0eb72a754287

	measure 'PL Budget Base' = CALCULATE([PL Value], Dim_Scenario[Scenario] = "Budget - Base")
		formatString: #,##0;(#,##0);-
		displayFolder: Base
		lineageTag: 2ea55c8e-e9fb-53fa-b872-eb68575ffd10

	measure 'PL Budget Adverse' = CALCULATE([PL Value], Dim_Scenario[Scenario] = "Budget - Adverse")
		formatString: #,##0;(#,##0);-
		displayFolder: Base
		lineageTag: 527e788b-9df0-534d-878b-de61b7482bfc

	measure 'PL Budget Favorable' = CALCULATE([PL Value], Dim_Scenario[Scenario] = "Budget - Favorable")
		formatString: #,##0;(#,##0);-
		displayFolder: Base
		lineageTag: 005acb47-5f7b-58d1-9f39-8f5fe1fbfe67

	measure 'PL Variance vs Base' = IF(NOT ISBLANK([PL Actual]) && NOT ISBLANK([PL Budget Base]), [PL Actual] - [PL Budget Base])
		formatString: #,##0;(#,##0);-
		displayFolder: Base
		lineageTag: 2c0b5638-9b53-5a91-8f35-6c0231e95945

	measure 'PL Variance % vs Base' = DIVIDE([PL Variance vs Base], ABS([PL Budget Base]))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Base
		lineageTag: 4a282a4c-55e2-5d54-9bf8-6d3afb3b60fa

	measure 'FY25 Budget (Base)' = CALCULATE([PL Budget Base], Dim_Year[Year] = "FY2025")
		formatString: #,##0;(#,##0);-
		displayFolder: Budget vs Actual
		lineageTag: f7b10b55-90e7-58ae-ba95-bfb31c8538b4

	measure 'FY25 Actual' = CALCULATE([PL Actual], Dim_Year[Year] = "FY2025")
		formatString: #,##0;(#,##0);-
		displayFolder: Budget vs Actual
		lineageTag: b5661e8b-5ff5-5656-aa5b-f382f56bfb07

	measure 'FY25 Variance' = CALCULATE([PL Variance vs Base], Dim_Year[Year] = "FY2025")
		formatString: #,##0;(#,##0);-
		displayFolder: Budget vs Actual
		lineageTag: 16e50331-867a-58e2-ab41-c36b6a0fd567

	measure 'FY25 Variance %' = CALCULATE([PL Variance % vs Base], Dim_Year[Year] = "FY2025")
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Budget vs Actual
		lineageTag: 1c403b7d-9cec-57af-9dce-81645e09d07e

	measure 'Net Profit Bridge' = VAR s = SELECTEDVALUE(Dim_LineItem[NPBridgeSign], 0) RETURN IF(s <> 0, s * [FY25 Variance])
		formatString: #,##0;(#,##0);-
		displayFolder: Budget vs Actual
		lineageTag: 6a99b581-3096-5985-9727-780890a160a5

	measure 'Sales Actual' = CALCULATE([PL Actual], Dim_LineItem[LineItem] = "Sales")
		formatString: #,##0;(#,##0);-
		displayFolder: Trend
		lineageTag: 29fef2d7-cf6a-534a-b02d-70bc78145913

	measure 'Sales Budget (Base)' = CALCULATE([PL Budget Base], Dim_LineItem[LineItem] = "Sales")
		formatString: #,##0;(#,##0);-
		displayFolder: Trend
		lineageTag: f160b0ff-593e-5ba2-b84a-d1c9ffd6f307

	measure 'UTOP Margin Actual' = DIVIDE(CALCULATE([PL Actual], Dim_LineItem[LineItem] = "UTOP"), [Sales Actual])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Trend
		lineageTag: 0b8cdf1d-67b2-5aa1-859b-392974c46aaf

	measure 'UTOP Margin Budget (Base)' = DIVIDE(CALCULATE([PL Budget Base], Dim_LineItem[LineItem] = "UTOP"), [Sales Budget (Base)])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Trend
		lineageTag: 10b2856f-b53b-5f18-8349-4e5c2667bc7f

	measure 'Net Profit Actual' = CALCULATE([PL Actual], Dim_LineItem[LineItem] = "Net profit")
		formatString: #,##0;(#,##0);-
		displayFolder: Trend
		lineageTag: f9809555-f6a2-52f2-a9a4-805db7936488

	measure 'Net Profit Budget (Base)' = CALCULATE([PL Budget Base], Dim_LineItem[LineItem] = "Net profit")
		formatString: #,##0;(#,##0);-
		displayFolder: Trend
		lineageTag: 30c84074-9bdb-58aa-bbba-bdcd615335cc

	measure 'Net Profit Margin Actual' = DIVIDE([Net Profit Actual], [Sales Actual])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Trend
		lineageTag: 493db50a-0b60-5213-a7cf-2e82cb64d410

	measure 'KPI Sales' = CALCULATE([Sales Actual], Dim_Year[Year] = "FY2025")
		formatString: #,##0;(#,##0);-
		displayFolder: KPI
		lineageTag: e1f62fc4-6fca-5d78-ba9b-fba2918c3ebe

	measure 'KPI Sales vs Budget' = VAR a = [KPI Sales] VAR b = CALCULATE([Sales Budget (Base)], Dim_Year[Year] = "FY2025") RETURN "Budget " & FORMAT(b, "#,##0") & "  |  " & FORMAT(DIVIDE(a - b, ABS(b)), "+0.0%;-0.0%")
		displayFolder: KPI
		lineageTag: d4b866ae-9ec5-5386-a6c8-10f79f492969

	measure 'KPI UTOP Margin' = CALCULATE([UTOP Margin Actual], Dim_Year[Year] = "FY2025")
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPI
		lineageTag: 86f04cfa-3e9b-53c0-9d50-72d5c2fb66ea

	measure 'KPI UTOP Margin vs Budget' = VAR a = [KPI UTOP Margin] VAR b = CALCULATE([UTOP Margin Budget (Base)], Dim_Year[Year] = "FY2025") RETURN "Budget " & FORMAT(b, "0.0%") & "  |  " & FORMAT((a - b) * 10000, "+0;-0") & " bps"
		displayFolder: KPI
		lineageTag: 8a8dec36-f782-5b2b-834f-a8c6b08990fb

	measure 'KPI Net Profit' = CALCULATE([Net Profit Actual], Dim_Year[Year] = "FY2025")
		formatString: #,##0;(#,##0);-
		displayFolder: KPI
		lineageTag: 6c5be1d7-db49-5441-9562-9a6bc78ae785

	measure 'KPI Net Profit vs Budget' = VAR a = [KPI Net Profit] VAR b = CALCULATE([Net Profit Budget (Base)], Dim_Year[Year] = "FY2025") RETURN "Budget " & FORMAT(b, "#,##0") & "  |  " & FORMAT(DIVIDE(a - b, ABS(b)), "+0.0%;-0.0%")
		displayFolder: KPI
		lineageTag: 603c8275-b760-522c-9b43-aa1160be4730

	measure 'Scenario Sales FY25' = CALCULATE([PL Value], Dim_LineItem[LineItem] = "Sales", Dim_Year[Year] = "FY2025")
		formatString: #,##0;(#,##0);-
		displayFolder: Scenarios
		lineageTag: dc486694-272c-5777-a47b-861f9c347921

	measure 'Scenario Net Profit FY25' = CALCULATE([PL Value], Dim_LineItem[LineItem] = "Net profit", Dim_Year[Year] = "FY2025")
		formatString: #,##0;(#,##0);-
		displayFolder: Scenarios
		lineageTag: 7807bdfe-ebb1-5edf-b696-20ec572e81bd

	measure 'FY24 Actual' = CALCULATE([PL Actual], Dim_Year[Year] = "FY2024")
		formatString: #,##0;(#,##0);-
		displayFolder: Budget scenarios
		lineageTag: ed802401-10d2-5037-b188-7a7a94bfb7a3

	measure 'FY25 Budget Adverse' = CALCULATE([PL Budget Adverse], Dim_Year[Year] = "FY2025")
