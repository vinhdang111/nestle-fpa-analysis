		displayFolder: Budget scenarios
		lineageTag: 3aea5013-1866-5c03-bfb7-53f0d6f60617

	measure 'FY25 Budget Favorable' = CALCULATE([PL Budget Favorable], Dim_Year[Year] = "FY2025")
		formatString: #,##0;(#,##0);-
		displayFolder: Budget scenarios
		lineageTag: f3c3a63e-2f36-50fd-a8f4-4f9b70f02292

	measure 'Scenario Bar Color' = SWITCH(SELECTEDVALUE(Dim_Scenario[Scenario]), "Budget - Adverse", "#B5543C", "Budget - Base", "#63513D", "Budget - Favorable", "#6F8B4E", "Actual", "#3E4B57", "#B08D57")
		displayFolder: Formatting
		lineageTag: 807da21c-1ea5-5876-8cef-b9ffe0f80ece

