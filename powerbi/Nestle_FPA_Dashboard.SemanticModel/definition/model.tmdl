model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Dim_Year","Dim_Scenario","Dim_LineItem","Fact_PL","Fact_CF","Fact_EPS","Fact_GrowthBridge","Fact_Segment","Fact_Category","Fact_Drivers","Fact_BudgetView"]

annotation PBI_ProTooling = ["DevMode"]

ref table Dim_Year
ref table Dim_Scenario
ref table Dim_LineItem
ref table Fact_PL
ref table Fact_CF
ref table Fact_EPS
ref table Fact_GrowthBridge
ref table Fact_Segment
ref table Fact_Category
ref table Fact_Drivers
ref table Fact_BudgetView

ref cultureInfo en-US

