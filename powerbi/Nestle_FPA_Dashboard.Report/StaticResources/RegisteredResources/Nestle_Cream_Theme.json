{
  "name": "Nestle Cream",
  "dataColors": [
    "#63513D",
    "#B08D57",
    "#5E7486",
    "#6F8B4E",
    "#B5543C",
    "#8A6D8F",
    "#4F7C74",
    "#C9A44C",
    "#3E4B57",
    "#A7907A"
  ],
  "background": "#FFFCF4",
  "foreground": "#3A3027",
  "tableAccent": "#63513D",
  "good": "#6F8B4E",
  "neutral": "#B08D57",
  "bad": "#B5543C",
  "textClasses": {
    "callout": {
      "fontSize": 22,
      "fontFace": "Segoe UI Semibold",
      "color": "#3A3027"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#63513D"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#63513D"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#3A3027"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F9F3E1"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F9F3E1"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFCF4"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E4D6B5"
              }
            },
            "radius": 8,
            "width": 1
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#63513D"
              }
            },
            "fontSize": 11
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#7B6E5D"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#EFE5CC"
              }
            },
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#7B6E5D"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#EFE5CC"
              }
            },
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#3A3027"
              }
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#63513D"
              }
            }
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#3A3027"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFCF4"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#3A3027"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F6EEDA"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#63513D"
              }
            },
            "backColor": {
              "solid": {
                "color": "#EFE3C4"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#EFE5CC"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#E4D6B5"
              }
            }
          }
        ]
      }
    }
  }
}